# Copy this file to .env before running docker compose.
#
# For HTTPS, set DOMAIN to the public host that points at this machine and add
# https://DOMAIN/auth/callback as the redirect URI in your Spotify app.
DOMAIN=spotify-curator.example.com
FRONTEND_URL=https://spotify-curator.example.com
SPOTIFY_REDIRECT_URI=https://spotify-curator.example.com/auth/callback

# Compose runtime settings.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:////data/spotify_curator.db
SPOTIFY_CURATOR_IMAGE=spotify-curator:latest

# SQLite data is stored under ./data as spotify_curator.db plus possible WAL/SHM
# sidecar files. Stop the app, use SQLite's backup API, or take an atomic
# filesystem snapshot before copying database files.

# Spotify developer dashboard credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# App secret used for signed session state. REQUIRED (>=32 chars).
# Generate a unique value per deployment before starting Compose:
#   openssl rand -hex 32
# Leave blank here on purpose — copy to .env and fill it in.
SECRET_KEY=

# AI provider keys. See backend/config.yaml for provider and transport settings.
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_API_KEY=
